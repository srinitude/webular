---
// The install commands as two tab rows ("Terminal" and "Your agent"). The
// inline script in Base.astro switches tabs and runs Copy; without it, every
// panel shows, stacked.
import Tabs from './Tabs.astro'

interface Props {
  firstId?: string
  agent?: boolean
}
const { firstId, agent = true } = Astro.props
const id = firstId ?? 'install-again'
const curl = "curl --proto '=https' --tlsv1.2 -fsSL https://webular.dev/install.sh | sh"
const claude = 'claude mcp add webular -- webular mcp'
const terminal = [
  ['macOS and Linux', curl],
  ['Windows', 'irm https://webular.dev/install.ps1 | iex'],
  ['npm', 'npm i -g webular'],
]
---

<div class="install-block" data-tabs>
  <div class="tab-rows">
    <Tabs id={id} label="Terminal" tabs={terminal.map(([label]) => label)} />
    {agent && (
      <Tabs id={id} label="Your agent" tabs={['Claude Code']} start={3}>
        <a class="tab-link" href="/install#agents">Other clients →</a>
      </Tabs>
    )}
  </div>
  <div class="tab-panel" role="tabpanel" id={`${id}-panel-0`} aria-labelledby={`${id}-tab-0`}>
    <div class="code-row">
      <pre id={firstId} tabindex="0"><code>curl --proto '=https' --tlsv1.2 -fsSL<span class="br-mid"> \
  </span><span class="br-wide"> </span>https://webular.dev/install.sh<span class="br-narrow">
  </span><span class="br-rest"> </span>| sh</code></pre>
      <button type="button" class="copy" data-copy={curl}>Copy</button>
    </div>
    <p>Downloads the webular build that matches your machine (OS, CPU, and libc), checks it against SHA256SUMS, and puts it in <code>~/.webular/bin</code>. <a href="/install.sh">View the script</a>.</p>
  </div>
  <div class="tab-panel" role="tabpanel" id={`${id}-panel-1`} aria-labelledby={`${id}-tab-1`}>
    <div class="code-row">
      <pre tabindex="0"><code>{terminal[1][1]}</code></pre>
      <button type="button" class="copy" data-copy={terminal[1][1]}>Copy</button>
    </div>
    <p>Checks the download against SHA256SUMS and puts it in <code>$HOME\.webular\bin</code>. <a href="/install.ps1">View the script</a>.</p>
  </div>
  <div class="tab-panel" role="tabpanel" id={`${id}-panel-2`} aria-labelledby={`${id}-tab-2`}>
    <div class="code-row">
      <pre tabindex="0"><code>{terminal[2][1]}</code></pre>
      <button type="button" class="copy" data-copy={terminal[2][1]}>Copy</button>
    </div>
    <p>Installs only the native build for your OS, CPU, and libc.</p>
  </div>
  {agent && (
    <div class="tab-panel" role="tabpanel" id={`${id}-panel-3`} aria-labelledby={`${id}-tab-3`}>
      <p>First install webular with a Terminal tab. Then run:</p>
      <div class="code-row">
        <pre tabindex="0"><code>{claude}</code></pre>
        <button type="button" class="copy" data-copy={claude}>Copy</button>
      </div>
    </div>
  )}
  <p class="path-note">If the script says to add <code>~/.webular/bin</code> to your PATH, do that. Then open a new terminal and run <code>webular doctor</code>.</p>
  <p class="visually-hidden" aria-live="polite" data-copy-status></p>
</div>
