---
import Base from '../Base.astro'
import RunLine from '../RunLine.astro'
import WebArt from '../WebArt.astro'

const release = import.meta.env.PUBLIC_RELEASE_VERSION ?? '0.3.0'
const description =
  'Search, scrape, crawl, and answer with sources, from your own machine. A CLI and MCP server with one optional key: Jev.'
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'webular',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: 'https://webular.dev/install.sh',
  installUrl: 'https://webular.dev/install',
  softwareVersion: release,
  author: { '@type': 'Person', name: 'Kiren Srinivasan' },
  sameAs: ['https://github.com/srinitude/webular', 'https://www.npmjs.com/package/webular'],
})
// The first 3 of the 10 rows a real keyless `search "sqlite wal"` printed.
const rows = [
  ['SQLite WAL-reset database corruption bug', 'https://sqlite.org/wal.html#walresetbug'],
  ['SQLite', 'https://en.wikipedia.org/wiki/SQLite'],
  [
    'agentscope-ai-java/sqlite-wal-doctor',
    'https://github.com/agentscope-ai-java/sqlite-wal-doctor',
  ],
]
// The lead tile first, then the six in reading order.
const tiles = [
  ['Add 24 MCP tools to your agent', '/install#agents'],
  ['Where your searches and data go', '/privacy'],
  ['22 commands in one tidy CLI', '/commands'],
  ['See how results were picked with --why', '/commands'],
  ['How webular stacks up', '/benchmarks'],
  ['More ways to install and start spinning', '/install'],
  ['Download checks and safe agent mode', '/security'],
]
---

<Base title="webular: search, scrape, crawl, and answer with sources" description={description} home>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLd} />

  <section class="hero run-hero" aria-labelledby="hero-title">
    <div class="run-block">
      <h1 id="hero-title">webular does web research from your own machine with no paid API. Copy one line and watch it spin up.</h1>
      <RunLine lines={['npx webular@0.3.2', 'search "sqlite wal"']} id="hero-command" label="Run this first" />
      <ol class="search-rows" tabindex="0" aria-label="What search prints">
        {rows.map(([title, url]) => <li>{title}<br />{url}</li>)}
      </ol>
      <p class="result-tag"><span class="tag-wide">Nice catch: 10 results in one go, 3 shown. No key, no sign-up.</span><span class="tag-narrow">Nice catch: 10 results, 2 shown. No key.</span></p>
      <h2 class="next">Next: plug the whole web into your agent.</h2>
      <RunLine command="npx webular@0.3.2 mcp" label="Add to your agent" />
      <p class="json-note">Add --json to any command. Same tidy JSON, every time.</p>
    </div>
    <WebArt labeled />
  </section>

  <section class="tile-band" aria-label="Where to go next">
    <ul class="tile-grid">
      {tiles.map(([label, href], i) => <li class={i ? undefined : 'tile-lead'}><a href={href}>{label} →</a></li>)}
    </ul>
  </section>
</Base>
