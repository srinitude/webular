---
// One labeled tab row: the label, then a tablist that holds only tabs, then
// any plain link from the slot. Tab n controls the panel `${id}-panel-${n}`,
// which the caller writes inside the same [data-tabs] block. The script in
// Base.astro switches panels, and arrow keys move within one tablist.
interface Props {
  id: string
  label: string
  tabs: string[]
  start?: number
  showLabel?: boolean
}
const { id, label, tabs, start = 0, showLabel = true } = Astro.props
const labelId = `${id}-label-${start}`
---

<div class="tab-row">
  <p class:list={['tab-label', { 'visually-hidden': !showLabel }]} id={labelId}>{label}</p>
  <div class="tab-line">
    <div class="scroll-row" role="tablist" aria-labelledby={labelId}>
      {tabs.map((tab, i) => {
        const n = start + i
        return (
          <button type="button" role="tab" id={`${id}-tab-${n}`} aria-controls={`${id}-panel-${n}`} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1}>{tab}</button>
        )
      })}
    </div>
    <slot />
  </div>
</div>
