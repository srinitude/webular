---
import './fonts.css'
import './tokens.css'
import './grid.css'
import './site.css'
import './sections.css'
import './widths.css'
import './tabs.css'

interface Props {
  title: string
  description: string
  home?: boolean
  doc?: boolean
  short?: boolean
}
const { title, description, home = false, doc = false, short = false } = Astro.props

const sha = import.meta.env.PUBLIC_BUILD_SHA ?? 'dev'
const date = import.meta.env.PUBLIC_BUILD_DATE ?? 'dev'
const github = 'https://github.com/srinitude/webular'
const pages = [
  ['Install', '/install'],
  ['Agents', '/agents'],
  ['Tools', '/tools'],
  ['Commands', '/commands'],
  ['Keys', '/keys'],
  ['Benchmarks', '/benchmarks'],
  ['Security', '/security'],
  ['Docs', '/docs'],
]
const current = Astro.url.pathname.replace(/\/$/, '')
// The footer links, in the design's order.
const footerLinks = [
  ...pages.filter(([label]) => label !== 'Docs').slice(0, 5),
  ['Benchmarks', '/benchmarks'],
  ['Security', '/security'],
  ['Privacy', '/privacy'],
  ['Support', '/support'],
  ['Docs', '/docs'],
  ['GitHub', github],
  ['llms.txt', '/llms.txt'],
]
// The home page footer keeps only the two outside links; its tiles reach the rest.
if (home)
  footerLinks.splice(0, footerLinks.length, ['GitHub', github], ['Releases', `${github}/releases`])
// A short page (install, docs, 404) gets the home footer look with the three nav links.
if (short)
  footerLinks.splice(
    0,
    footerLinks.length,
    ...pages.filter(([label]) => ['Install', 'Commands', 'Docs'].includes(label)),
  )
const darkFooter = home || short
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/archivo-black-400.latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-400.latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch{}</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href={home ? "#hero-command" : "#content"}>{home ? "Skip to install" : "Skip to content"}</a>
    <header class="site-header">
      <div class="wrap">
        <div class="brand"><a class="wordmark" href="/">webular</a><p class="tagline">Search, scrape, crawl, and answer with sources. Your own web, spun on your own machine.</p></div>
        <div class="header-end">
          <a class="nav-390" href="/install">Install</a>
          <a class="nav-390" href="/commands">Commands</a>
          <a class="nav-390" href="/docs">Docs</a>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Dark theme" aria-pressed="false">◐</button>
        </div>
      </div>
    </header>
    <main id="content" class:list={[{ "home-main": home }]}>
      <div class:list={["wrap", { "has-sidebar": doc }]}>
        {doc && (
          <aside class="sidebar">
            <nav aria-label="Pages">
              <ul>
                {pages.map(([label, href]) => (
                  <li><a href={href} aria-current={href === current ? "page" : undefined}>{label}</a></li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
        <div><slot /></div>
        {doc && (
          <aside class="toc">
            <nav aria-labelledby="toc-title">
              <h2 id="toc-title">On this page</h2>
              <ul data-toc></ul>
            </nav>
          </aside>
        )}
      </div>
    </main>
    <footer class:list={["site-footer", { "home-footer": darkFooter }]}>
      <div class="wrap">
        {darkFooter && <a class="footer-mark" href="/">webular</a>}
        <ul>
          {footerLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
        {!darkFooter && <p>Open source under Apache-2.0. © Kiren Srinivasan. This site sets no cookies and runs no tracking.</p>}
        {!darkFooter && <p class="muted">Built from commit <code>{sha}</code> on <code>{date}</code></p>}
      </div>
    </footer>
    <script>
      // One small vanilla script: theme toggle, tabs, Copy, and "On this page".
      const root = document.documentElement
      const dark = () => (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark'
      // The saved theme is applied by the inline head script before first paint.
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        const show = () => button.setAttribute('aria-pressed', String(dark()))
        show()
        button.addEventListener('click', () => {
          root.dataset.theme = dark() ? 'light' : 'dark'
          try { localStorage.setItem('theme', root.dataset.theme) } catch {}
          show()
        })
      }
      for (const block of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
        const tabs = [...block.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
        const select = (picked: HTMLButtonElement) => {
          for (const tab of tabs) {
            const on = tab === picked
            tab.setAttribute('aria-selected', String(on))
            tab.tabIndex = on ? 0 : -1
            const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '')
            if (panel) panel.hidden = !on
          }
        }
        select(tabs[0])
        block.addEventListener('click', (event) => {
          const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]')
          if (tab) select(tab)
        })
        // Arrow keys move between the tabs of one tablist, wrapping.
        block.addEventListener('keydown', (event) => {
          const list = [...((event.target as Element).closest('[role="tablist"]')?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? [])]
          const at = list.indexOf(event.target as HTMLButtonElement)
          const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key]
          if (at < 0 || !step) return
          const next = list[(at + step + list.length) % list.length]
          select(next)
          next.focus()
        })
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const status = button.closest('[data-tabs], [data-copy-region]')?.querySelector('[data-copy-status]')
          // Three states: idle (Copy), Copied, and Copy failed when the clipboard says no.
          const said = await navigator.clipboard.writeText(button.dataset.copy ?? '').then(() => 'Copied', () => 'Copy failed')
          button.textContent = said
          if (status) status.textContent = said
          setTimeout(() => { button.textContent = 'Copy'; if (status) status.textContent = '' }, 2000)
        })
      }
      const toc = document.querySelector('[data-toc]')
      for (const heading of toc ? document.querySelectorAll<HTMLElement>('.doc-body h2[id]') : []) {
        const item = document.createElement('li')
        const link = document.createElement('a')
        link.href = `#${heading.id}`
        link.textContent = heading.textContent
        item.append(link)
        toc?.append(item)
      }
    </script>
  </body>
</html>
