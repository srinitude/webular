---
// The 20 commands in five job groups. Each group is a native <details>, folded shut.
const groups: [string, [string, string, string][]][] = [
  [
    'Find',
    [
      [
        'search',
        'Searches the web with no key, or one keyless source',
        'webular search "bun runtime" --source wikipedia',
      ],
      ['map', 'Finds all URLs for a domain', 'webular map https://example.com'],
      [
        'feed',
        'Reads an RSS 2.0 or Atom 1.0 feed and lists its items',
        'webular feed https://hnrss.org/frontpage --limit 5',
      ],
    ],
  ],
  [
    'Read',
    [
      [
        'scrape',
        'Reads one URL as clean markdown or JSON',
        'webular scrape https://example.com --json',
      ],
      ['crawl', 'Reads a site page by page on the same host', 'webular crawl https://example.com'],
      ['batch', 'Scrapes many URLs at once', 'webular batch --help'],
      ['parse', 'Turns local docs into markdown', 'webular parse --help'],
      [
        'media',
        'Downloads media; takes a screenshot or PDF in a real browser',
        'webular media --help',
      ],
    ],
  ],
  [
    'Think',
    [
      ['extract', 'Pulls fields with CSS selectors or a schema', 'webular extract --help'],
      [
        'summarize',
        'Picks the key sentences (no model)',
        'webular summarize --text "..." --sentences 1',
      ],
      ['answer', 'Answers from sources', 'webular answer --help'],
      [
        'research',
        'Runs a multi-step research loop and writes a cited markdown report',
        'webular research "web scraping in 2026" --depth 3 -o report.md',
      ],
    ],
  ],
  [
    'Watch and act',
    [
      ['monitor', 'Tracks changes to a URL over time', 'webular monitor --help'],
      ['act', 'Drives a real browser', 'webular act --help'],
    ],
  ],
  [
    'Tools and setup',
    [
      ['doctor', 'Checks your setup and toolchain', 'webular doctor --json'],
      ['mcp', "Serves webular's features as an MCP server", 'webular mcp'],
      ['tasks', 'Lists the mise task graph that defines the commands', 'webular tasks'],
      ['diagram', 'Lists the XState machines that model the CLI flows', 'webular diagram'],
      ['audit', 'Reports whether deepsec is there, plus a scan plan', 'webular audit'],
      [
        'jev',
        'Learns from recorded Jev calls, or labels one as an eval case',
        'webular jev --help',
      ],
    ],
  ],
]
---

<div class="cards card-grid group-grid">
{groups.map(([name, commands]) => (
  <details class="group">
    <summary><span><h3>{name}</h3><code>{commands.map(([command]) => command).join(", ")}</code></span></summary>
    <ul class="cards card-grid">
      {commands.map(([command, line, example]) => (
        <li class="card">
          <p><code>{command}</code>: {line}.</p>
          <pre tabindex="0"><code>{example}</code></pre>
        </li>
      ))}
    </ul>
  </details>
))}
</div>
