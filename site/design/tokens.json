{
  "color": {
    "palette": {
      "caution-yellow": {
        "$type": "color",
        "$value": "#FFD400",
        "$description": "pen variable fill-ffd400 in webular-dev-direction-concepts.pen, frame iqsmD"
      },
      "ink": {
        "$type": "color",
        "$value": "#111111",
        "$description": "pen variable fill-111111 in webular-dev-direction-concepts.pen, frame iqsmD"
      },
      "paper": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "pen variable fill-ffffff in webular-dev-direction-concepts.pen, frame iqsmD"
      }
    }
  },
  "theme": {
    "bg": {
      "$type": "color",
      "$value": "{color.palette.caution-yellow}",
      "$description": "frame fill; dark swaps the two page colors",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.ink}",
          "light": "{color.palette.caution-yellow}"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{color.palette.paper}",
      "$description": "caught result card fill; dark keeps the page color and leans on the border",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.ink}",
          "light": "{color.palette.paper}"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$description": "every text fill; dark uses the paper white",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.paper}",
          "light": "{color.palette.ink}"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$description": "derived: the direction has no gray, so muted text is the text color and steps down by size",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.paper}",
          "light": "{color.palette.ink}"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$description": "card and output strokes; dark draws them in yellow",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.caution-yellow}",
          "light": "{color.palette.ink}"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$description": "the run line fill; links read as ink on yellow, yellow on ink",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.caution-yellow}",
          "light": "{color.palette.ink}"
        }
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.palette.caution-yellow}",
      "$description": "the command text on the run line",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.ink}",
          "light": "{color.palette.caution-yellow}"
        }
      }
    },
    "focus": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$description": "derived: the highest-contrast color on the page in each theme",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.caution-yellow}",
          "light": "{color.palette.ink}"
        }
      }
    },
    "brand": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$description": "the run line block; docs code blocks and the active link sit on it",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.caution-yellow}",
          "light": "{color.palette.ink}"
        }
      }
    },
    "on-brand": {
      "$type": "color",
      "$value": "{color.palette.caution-yellow}",
      "$description": "the command text color on the run line",
      "$extensions": {
        "modes": {
          "dark": "{color.palette.ink}",
          "light": "{color.palette.caution-yellow}"
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Archivo Black",
        "system-ui",
        "sans-serif"
      ],
      "$description": "pen variable fontfamily-archivoblack in webular-dev-direction-concepts.pen, frame iqsmD, the headline"
    },
    "mono": {
      "$type": "fontFamily",
