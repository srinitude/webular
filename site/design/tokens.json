  },
  "h2-size": {
    "$type": "dimension",
    "$value": { "value": 20, "unit": "px" },
    "$description": "Base section heading size at 320 px, 0.7 times the title size; grid.css writes the larger widths."
  },
  "body-size": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Base body text size at 320 px; grid.css raises it from 768 px up."
  },
  "lead-size": {
    "$type": "dimension",
    "$value": { "value": 18, "unit": "px" },
    "$description": "Base lead text size at 320 px, the body size plus 2 px; grid.css writes the larger widths."
  },
  "h3-size": {
    "$type": "dimension",
    "$value": "{lead-size}",
    "$description": "Small heading size; it follows the lead size."
  },
  "code-size": {
    "$type": "dimension",
    "$value": { "value": 14, "unit": "px" },
    "$description": "Base code text size at 320 px; grid.css raises it from 600 px up."
  },
  "section-gap": {
