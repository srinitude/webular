  },
  "content-max": {
    "$type": "dimension",
    "$value": { "value": 320, "unit": "px" },
    "$description": "Base content width at 320 px, the content row of 288 px plus two gutters; grid.css raises it from 360 px up."
  },
  "h1-size": {
    "$type": "dimension",
    "$value": { "value": 28, "unit": "px" },
