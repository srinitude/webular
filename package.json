{
  "name": "webular",
  "version": "0.2.0",
  "mcpName": "io.github.srinitude/webular",
  "description": "Web research CLI that sends its judgment calls to Jev, TypeSafe's System One decision model, and does the rest with free and open-source parts: scrape, crawl, map, extract, search, summarize, and gather context as Mastra workflows on Bun, run with Effect and XState from a fixed mise task graph. It runs on your machine, is open source, respects robots.txt by default, and can replay a run with the same result. Jev's key is the only API key, and it works without one.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kiren Srinivasan <kiren@fantasymetals.com>",
  "homepage": "https://github.com/srinitude/webular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srinitude/webular.git"
  },
  "bugs": {
    "url": "https://github.com/srinitude/webular/issues"
  },
  "keywords": [
    "web",
    "scraping",
    "scrape",
    "crawler",
    "crawl",
    "map",
    "extract",
    "search",
    "research",
    "summarize",
    "context",
    "cli",
    "mastra",
    "bun",
    "jev",
    "typesafe",
    "mastra-workflows",
    "effect",
    "xstate"
  ],
  "bin": {
    "webular": "./dist/webular.js"
  },
  "exports": {
    ".": "./src/cli/route.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist/webular.js",
    "dist/commands",
    "dist/chunks",
    "src",
    "mise.toml",
    "mise.lock",
    "bun.lock",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "mise run build"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@firecrawl/anydoc": "^0.2.4",
    "@mastra/core": "^1.78.0",
    "@mastra/mcp": "^2.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@statelyai/agent": "1.1.6",
    "agent-browser": "^0.39.1",
    "diff": "^9.0.0",
    "effect": "4.0.5",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "xstate": "5.33.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "mise": "2026.10.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/language-service": "0.87.5",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@types/bun": "^1.4.3",
    "@types/turndown": "^5.0.6",
    "@typescript/typescript6": "6.0.2",
    "ai": "3.4.33",
    "deepsec": "^2.3.10",
    "portless": "0.15.8",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "agent-browser",
    "mise"
  ]
}
