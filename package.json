{
  "name": "webular",
  "version": "0.1.0",
  "description": "Universal web research CLI — scrape, crawl, map, extract, search, summarize and gather context by composing free & open-source libraries into Mastra workflows/tools, orchestrated through a deterministic mise task graph.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kiren Srinivasan <kiren@fantasymetals.com>",
  "homepage": "https://github.com/srinitude/webular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srinitude/webular.git"
  },
  "bugs": {
    "url": "https://github.com/srinitude/webular/issues"
  },
  "keywords": [
    "web",
    "scraping",
    "scrape",
    "crawler",
    "crawl",
    "map",
    "extract",
    "search",
    "research",
    "summarize",
    "context",
    "cli",
    "mastra",
    "bun"
  ],
  "bin": {
    "webular": "./bin/webular.ts"
  },
  "files": [
    "bin",
    "src",
    "mise.toml",
    "docs/diagrams",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "agent-browser": "^0.27.1",
    "diff": "^9.0.0",
    "linkedom": "^0.18.12",
    "mammoth": "^1.12.0",
    "p-limit": "^7.3.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@mermaid-js/mermaid-cli": "latest",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/turndown": "^5.0.6",
    "deepsec": "latest",
    "opensrc": "latest",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
